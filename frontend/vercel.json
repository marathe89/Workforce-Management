{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-railway-api-url/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "https://your-railway-api-url/api/:path*",
      "permanent": false
    }
  ]
}
